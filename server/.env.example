# Copy this file to .env and fill in real values. Never commit .env.

# SMTP account used to SEND mail (e.g. a transactional mail provider, or a
# mailbox on genbionex.ug that allows SMTP submission).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=change-me

# Address that receives contact-form submissions.
TO_EMAIL=info@genbionex.ug

# Port the Node process listens on.
PORT=3000
